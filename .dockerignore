# Build-context exclusions for `docker build .` (ci/Dockerfile.linux-test).
# Keeps credentials, runtime state, and large artifacts out of image layers.
.git
.gitleaks.toml

# Credentials / tokens / secrets
.pyirc
.pypirc
.npmrc
.netrc
.devkit-token
.devkit-team-config
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.keystore
*.jks
id_rsa
id_ed25519
*_rsa
*_ed25519
.ssh/
**/secrets/
**/*.secret

# TLS material and runtime state
devkit-tls.crt
devkit-tls.key
*.crt
devkit-update-history.json

# Local tooling / IDE / agent state
.claude/
.vscode/
.idea/
.scannerwork/

# Build output & runtime dirs
dist/
devkit-logs/
prebuilt/bin/
user-packages/
checksums/
**/__pycache__/
*.log
