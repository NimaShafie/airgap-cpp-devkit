# RHEL / Rocky integration test container
#
# Validates that install-cli.sh, setup.sh scripts, and run-tests.sh all work on
# a RHEL / Rocky baseline with no EPEL and no internet access (once the image is
# built with the repo COPY'd in). The base image is parameterized so the same
# Dockerfile covers the whole support matrix — RHEL/Rocky 8, 9 and 10 — with 9
# as the default. glibc floors: 8 → 2.28, 9 → 2.34, 10 → 2.39.
#
# Build (default, UBI 9):
#   docker build -f ci/Dockerfile.linux-test -t airgap-devkit-linux .
#
# Build for a specific major:
#   docker build -f ci/Dockerfile.linux-test \
#     --build-arg UBI_IMAGE=registry.access.redhat.com/ubi8/ubi:8.10 \
#     -t airgap-devkit-linux:8 .
#
# Run full install + tests:
#   docker run --rm airgap-devkit-linux
#
# Run only script syntax validation (no actual installs):
#   docker run --rm airgap-devkit-linux bash /workspace/tests/lint-scripts.sh
#
# Run with a custom profile:
#   docker run --rm -e DEVKIT_PROFILE=minimal airgap-devkit-linux

# Default to UBI 9 (the documented baseline). The CI matrix overrides this with
# ubi8/ubi:8.10 and ubi10/ubi:10.0 to cover the full support matrix.
ARG UBI_IMAGE=registry.access.redhat.com/ubi9/ubi:9.5
FROM ${UBI_IMAGE}

# Install only packages available in the UBI base — no EPEL.
# tar/xz/bzip2/gzip: needed by many setup.sh archives
# cpio: non-root RPM payload extraction (rpm2cpio | cpio), e.g. sqlite
# findutils/which/file: standard tooling used by setup.sh guards
# gcc/gcc-c++: the system C/C++ compiler a real RHEL dev box provides — the
#   devkit ships no Linux compiler (winlibs is Windows-only), so source builds
#   such as zlib rely on it. Both live in BaseOS/AppStream (no EPEL needed).
# sudo: lets the test user do privilege escalation for /opt installs
# A single layer: install base packages, then create a non-root user that
# mirrors a typical developer account. Pre-create the install prefix owned by
# devkit so no sudo is needed at all. A narrow sudo allowlist covers edge cases
# in setup.sh scripts that still need to write to /opt paths not pre-created.
RUN dnf install -y \
      bash \
      git \
      tar \
      xz \
      bzip2 \
      gzip \
      cpio \
      findutils \
      which \
      file \
      make \
      gcc \
      gcc-c++ \
      perl \
      sudo \
      shadow-utils \
 && dnf clean all \
 && useradd -m -s /bin/bash devkit \
 && mkdir -p /opt/airgap-cpp-devkit \
 && chown -R devkit:devkit /opt/airgap-cpp-devkit \
 && echo "devkit ALL=(ALL) NOPASSWD: /usr/bin/install, /bin/mkdir, /bin/cp, /bin/chown, /bin/chmod" \
    >> /etc/sudoers.d/devkit \
 && chmod 0440 /etc/sudoers.d/devkit

# Copy the repo into the container. Files stay owned by root so the
# unprivileged runtime user (USER devkit, below) can read and execute them but
# not modify the toolkit sources — installs target /opt and $HOME, never
# /workspace. A .dockerignore keeps credentials, tokens, and runtime state out
# of the build context.
# In CI, make sure the prebuilt/ submodule is checked out first:
#   git submodule update --init prebuilt
COPY . /workspace

WORKDIR /workspace
USER devkit

# Default: install the cpp-dev profile then run the full smoke-test suite.
# Override DEVKIT_PROFILE to test a different profile (minimal, devops, full).
ENV DEVKIT_PROFILE=cpp-dev

# No HEALTHCHECK by design: this image runs the test suite once and exits, so
# there is no long-lived service to probe. It is a CI harness, never deployed.
CMD ["bash", "/workspace/ci/linux-test-entrypoint.sh"]
