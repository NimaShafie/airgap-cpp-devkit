# Debian / Ubuntu (glibc) integration test container.
#
# Proves the glibc-floor artifacts install on a non-RHEL glibc distro with no
# per-distro code: the rhel8 (glibc-2.28) LLVM floor, the static-glibc sqlite3,
# the glibc python standalone, and the zlib source build all run here.
#
# Build (default Debian 12):
#   docker build -f ci/Dockerfile.debian-test -t airgap-devkit-debian .
# Override the base:
#   docker build -f ci/Dockerfile.debian-test --build-arg BASE_IMAGE=ubuntu:22.04 ...

ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# System toolchain + tools the setup.sh guards expect. gcc/g++ = the compiler a
# real dev box provides (the devkit ships no Linux compiler); xz-utils = xz;
# debianutils provides `which`; file/findutils mirror the RHEL image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      git \
      tar \
      xz-utils \
      bzip2 \
      gzip \
      unzip \
      cpio \
      findutils \
      file \
      make \
      gcc \
      g++ \
      perl \
      sudo \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash devkit \
 && mkdir -p /opt/airgap-cpp-devkit \
 && chown -R devkit:devkit /opt/airgap-cpp-devkit \
 && echo "devkit ALL=(ALL) NOPASSWD: /usr/bin/install, /bin/mkdir, /bin/cp, /bin/chown, /bin/chmod" \
    >> /etc/sudoers.d/devkit \
 && chmod 0440 /etc/sudoers.d/devkit

COPY . /workspace
WORKDIR /workspace
USER devkit

ENV DEVKIT_PROFILE=cpp-dev
# No HEALTHCHECK by design: this image runs the test suite once and exits, so
# there is no long-lived service to probe. It is a CI harness, never deployed.
CMD ["bash", "/workspace/ci/linux-test-entrypoint.sh"]
